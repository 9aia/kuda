# ~/.config/kuda/env (chmod 600) — secrets only; everything
# else is in kuda.toml. Alternatively store them in your OS
# keyring: secret-tool store --label='kuda: NAME' service kuda name NAME
KUDA_WEBHOOK_SECRET=
KUDA_TOKEN=                  # repo-scoped PAT: statuses + webhook admin
# CARGO_REGISTRY_TOKEN=       # only if a repo uses scripts/release.sh
