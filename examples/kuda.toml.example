# kuda.toml — per-repo index config. Secrets (LLM provider keys)
# resolve via env var -> OS keyring -> ~/.config/kuda/env; never here.

[repo]
# name = "kuda"                    # default: directory basename
# root = "."                       # repo root (default: toml's dir)

[extract]
kinds = ["manifest", "treesitter", "records"] # adapter crates, tried in order
# lsp_server = "rust-analyzer"     # kuda-lsp adapter: server cmd per lang

[summarize]
kind = "template"                  # deterministic cards, zero-model
# kind = "acp"                     # adapter: kuda-acp — any ACP agent
# acp_cmd = "cline --acp"          # prefer lightweight/no-tool agents:
                                  # heavyweight clients (e.g. `devin acp`
                                  # boots a full MCP stack per spawn) work
                                  # but are overkill for batch card prose
# kind = "llm"                     # adapter: kuda-llm
# provider = "anthropic"           # key via KUDA_LLM_KEY env/keyring
# model = "..."

[store]
kind = "sqlite"                    # adapter: kuda-store-sqlite
path = ".kuda/index.sqlite"        # L2 graph — rebuildable, gitignored

[cards]
dir = ".kuda"                      # index.yaml + modules/*.yaml — committed

[domains]
# disable = ["media"]              # drop built-in corpora by name
                                   # (built-ins: myco, docs, media)

# [[domain]]                       # repo-local corpus — or same
# name = "myco"                    # name as a built-in to replace it
# roots = ["ops/project"]
# extensions = [".md"]
# module = "ops-ledger"            # card + provenance grouping
# purpose = "ops ledger"
# record_patterns = ['-\s*(?:\[[ xX]\]\s*)?([A-Z]+-[0-9]+)']
# ref_pattern = '\b[A-Z]+-[0-9]+\b'
# schema_json = ''' {...} '''      # optional JSON Schema for
                                  # frontmatter records
# file_records = true              # optional: file-as-record mode
                                  # (binaries — no patterns needed)

[workspace]
# roots = ["../cli", "../lsp"]     # sibling repos indexed together
# resolve_git_deps = true          # git deps -> sibling checkouts
